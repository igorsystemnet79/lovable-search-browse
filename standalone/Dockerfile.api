FROM node:22-alpine
WORKDIR /app
# Keep the same repository layout as Render Native Node: server.mjs expects
# /app/standalone/api and resolves the complete application root as /app.
COPY . /app
WORKDIR /app/standalone/api
RUN apk add --no-cache postgresql-client unzip \
 && npm install --omit=dev
RUN mkdir -p /data/uploads && chown -R node:node /data
USER node
ENV UPLOAD_DIR=/data/uploads API_PORT=4000 NODE_ENV=production
EXPOSE 4000
CMD ["node","server.mjs"]
