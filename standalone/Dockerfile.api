FROM node:22-alpine
WORKDIR /app
RUN apk add --no-cache postgresql-client unzip
COPY standalone/api/package.json ./package.json
RUN npm install --omit=dev
COPY standalone/api/server.mjs ./server.mjs
COPY standalone/api/business-catalog.mjs ./business-catalog.mjs
COPY standalone/api/backup-export.mjs ./backup-export.mjs
COPY standalone/db/init.sql /db/init.sql
RUN mkdir -p /data/uploads && chown -R node:node /data
USER node
ENV UPLOAD_DIR=/data/uploads API_PORT=4000 NODE_ENV=production
EXPOSE 4000
CMD ["node","server.mjs"]
