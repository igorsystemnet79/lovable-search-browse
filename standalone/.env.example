POSTGRES_PASSWORD=replace-with-a-long-random-database-password
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=your-admin-email@example.com

# Backup export/import stay disabled until the archive and restore flow are verified.
ENABLE_ADMIN_BACKUP_EXPORT=false
ENABLE_ADMIN_BACKUP_IMPORT=false
DOMAIN=:80

# Pregledač koristi isti domen; Caddy prosleđuje /api i /uploads direktno API servisu.
VITE_API_ORIGIN=same-origin
# Build-time Nitro proxy cilj ako se web servis koristi bez Caddy reverse proxy-ja.
PONUDIMI_API_ORIGIN=http://api:4000

# Javni URL platforme i SMTP (potrebno za oporavak lozinke)
PUBLIC_APP_URL=http://localhost

# Google OAuth prijava (redirect URI u Google Cloud mora biti identičan GOOGLE_REDIRECT_URI)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/api/auth/google/callback
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Podrazumevano se fotografije čuvaju u PostgreSQL bazi.
# Za trajni lokalni disk postavi IMAGE_STORAGE_MODE=filesystem i obezbedi trajni UPLOAD_DIR.
IMAGE_STORAGE_MODE=

# Opcionalno S3-kompatibilno skladište (Cloudflare R2).
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
