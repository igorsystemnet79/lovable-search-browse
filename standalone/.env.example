POSTGRES_PASSWORD=replace-with-a-long-random-database-password
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=your-admin-email@example.com
DOMAIN=:80

# Javni URL platforme i SMTP (potrebno za oporavak lozinke)
PUBLIC_APP_URL=http://localhost
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Twilio Verify — obavezno za SMS potvrdu broja telefona
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Opcionalno S3-kompatibilno skladište (Cloudflare R2). Bez ovih vrednosti koristi se lokalni disk.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
