POSTGRES_PASSWORD=replace-with-a-long-random-database-password
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=your-admin-email@example.com
DOMAIN=:80

# Opcionalno: API može biti na posebnom domenu. Prazno ili same-origin koristi isti domen preko Caddy reverse proxy-ja.
VITE_API_ORIGIN=same-origin

# Javni URL platforme i SMTP (potrebno za oporavak lozinke)
PUBLIC_APP_URL=http://localhost

# Google OAuth prijava (redirect URI u Google Cloud mora biti identičan GOOGLE_REDIRECT_URI)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Opcionalno S3-kompatibilno skladište (Cloudflare R2). Bez ovih vrednosti koristi se lokalni disk.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
